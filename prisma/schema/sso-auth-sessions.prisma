model SsoAuthSession {
  id         Int       @id @default(autoincrement()) @db.UnsignedInt
  ssoUserId     Int       @map("sso_user_id") @db.UnsignedInt
  tokenHash  String    @unique @map("token_hash") @db.Char(64)

  expiresAt  DateTime  @map("expires_at") @db.DateTime(6)
  revokedAt  DateTime? @map("revoked_at") @db.DateTime(6)
  lastUsedAt DateTime? @map("last_used_at") @db.DateTime(6)

  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.VarChar(512)

  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(6)

  ssoUser    SsoUser   @relation(fields: [ssoUserId], references: [id], onDelete: Cascade)

  @@index([ssoUserId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("sso_auth_sessions")
}