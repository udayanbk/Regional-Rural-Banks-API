// ==========================================
// AUTHENTICATION SESSIONS
// ==========================================

model RrbAuthSession {
  id     Int @id @default(autoincrement()) @db.UnsignedInt
  rrbUserId Int @map("rrb_user_id") @db.UnsignedInt

  // SHA-256 hash of the browser session token
  tokenHash String @unique @map("token_hash") @db.Char(64)

  expiresAt  DateTime  @map("expires_at") @db.DateTime(6)
  revokedAt  DateTime? @map("revoked_at") @db.DateTime(6)
  lastUsedAt DateTime? @map("last_used_at") @db.DateTime(6)

  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.VarChar(512)

  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)

  user RrbUser @relation(fields: [rrbUserId], references: [id], onDelete: Cascade)

  @@index([rrbUserId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("rrb_auth_sessions")
}
